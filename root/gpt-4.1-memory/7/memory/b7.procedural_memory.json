      "retrieval_key": "conditional assignment over multiple value ranges",
      "api_concepts": "boolean masking, loc assignment, iterative mask construction",
      "procedure": "1. Initialize a boolean mask to False for all elements. 2. For each value range in the list of target ranges, update the mask by combining it with the condition that checks if each element falls within the current range. 3. After constructing the combined mask, apply the desired assignment only to the elements where the mask is True. 4. Ensure that all other elements remain unchanged.",
      "avoid_assumption": "Assuming a fixed number of ranges or conditions when constructing selection masks.",
      "applicability_conditions": "When conditional assignment is needed for elements matching any of several value ranges or conditions, especially when the number of ranges is variable.",
      "non_applicability_conditions": "When assignment applies to all elements, or only a single fixed range or condition is present.",
      "preserve_constraints": "Preserve DataFrame shape, column order, data types, and unaffected values and rows.",
      "verification": "Only elements matching any specified range are updated; all other elements and structure remain unchanged.",
      "confidence": "high"
    },
